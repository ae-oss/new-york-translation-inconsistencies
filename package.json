{
  "name": "new-york-translation-inconsistencies",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "validate:data": "node scripts/validate-public-data.mjs",
    "validate:legal": "node scripts/validate-legal-data.mjs",
    "refresh:legal": "node scripts/build-legal-preview.mjs && node scripts/validate-legal-data.mjs",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/validate-public-data.mjs && node scripts/validate-legal-data.mjs && next build"
  },
  "dependencies": {
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.9.0"
  }
}
